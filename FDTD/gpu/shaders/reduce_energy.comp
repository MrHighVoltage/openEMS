/*
 * GPU-side energy reduction shader.
 *
 * Computes a rough estimate of total E-field and H-field energy:
 *   E_energy = sum_over_cells( volt[0]^2 + volt[1]^2 + volt[2]^2 )
 *   H_energy = sum_over_cells( curr[0]^2 + curr[1]^2 + curr[2]^2 )
 *
 * Uses a grid-stride loop so that a fixed number of workgroups (NUM_WG)
 * covers the entire field.  Each workgroup reduces via shared memory and
 * writes one (E_partial, H_partial) pair to the output buffer.
 * The CPU sums the NUM_WG partials (trivially fast).
 *
 * Dispatch: vkCmdDispatch(cmd, NUM_WG, 1, 1)  where NUM_WG <= 256.
 *
 * Memory layout: N-I-J-K, index(n,x,y,z) = n*N + x*Ny*Nz + y*Nz + z,
 * but the reduction doesn't depend on spatial decomposition — just
 * iterates linearly over [0, N) for each component.
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) readonly buffer VoltBuf { float volt[]; };
layout(set=0, binding=1) readonly buffer CurrBuf { float curr[]; };
layout(set=0, binding=2) writeonly buffer OutBuf  { float partials[]; };  // [2 * NUM_WG]

layout(push_constant) uniform PC {
    uint N;        // Nx * Ny * Nz  (total cells, NOT 3*N)
    uint numWG;    // number of workgroups dispatched
};

shared float s_E[256];
shared float s_H[256];

void main()
{
    uint lid  = gl_LocalInvocationID.x;
    uint gid  = gl_GlobalInvocationID.x;
    uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;

    float accE = 0.0;
    float accH = 0.0;

    // Grid-stride loop over all cells
    for (uint i = gid; i < N; i += stride)
    {
        float v0 = volt[i];
        float v1 = volt[N + i];
        float v2 = volt[2u * N + i];
        accE += fma(v0, v0, fma(v1, v1, v2 * v2));

        float c0 = curr[i];
        float c1 = curr[N + i];
        float c2 = curr[2u * N + i];
        accH += fma(c0, c0, fma(c1, c1, c2 * c2));
    }

    s_E[lid] = accE;
    s_H[lid] = accH;
    barrier();

    // Tree reduction in shared memory
    for (uint s = 128u; s > 0u; s >>= 1u)
    {
        if (lid < s)
        {
            s_E[lid] += s_E[lid + s];
            s_H[lid] += s_H[lid + s];
        }
        barrier();
    }

    // Workgroup leader writes partial sums
    if (lid == 0u)
    {
        uint wgId = gl_WorkGroupID.x;
        partials[wgId]         = s_E[0];
        partials[numWG + wgId] = s_H[0];
    }
}
