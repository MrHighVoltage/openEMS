/*
 * Mur 1st-order ABC: Apply to voltages stage.
 *
 * Overwrites the boundary face voltages with the Mur-corrected values:
 *   V(nyP,  pos) = mur_nyP(i,j)
 *   V(nyPP, pos) = mur_nyPP(i,j)
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) buffer VoltBuf    { float volt[];     };
layout(set=0, binding=1) buffer MurNyPBuf  { float mur_nyP[];  };
layout(set=0, binding=2) buffer MurNyPPBuf { float mur_nyPP[]; };

layout(push_constant) uniform PC {
    uint Nx, Ny, Nz;
    uint ny;
    uint lineNr;
    uint lineNrShift;   // unused but keeps PC consistent
    uint numLinesP;
    uint numLinesPP;
    uint xLo, xHi;           // x-slab clip for faces normal to y or z
    uint edgeSkip;           // edges an earlier face owns (apply only)
    uint faceOff;            // this face's first element in the concatenated buffers
};

uint gridIdx(uint ny_dir, uint lineVal, uint i, uint j)
{
    if (ny_dir == 0u)
        return lineVal * Ny*Nz + i * Nz + j;
    else if (ny_dir == 1u)
        return j * Ny*Nz + lineVal * Nz + i;
    else
        return i * Ny*Nz + j * Nz + lineVal;
}

uint compP(uint ny_dir)  { return (ny_dir + 1u) % 3u; }
uint compPP(uint ny_dir) { return (ny_dir + 2u) % 3u; }

// Temporal blocking: a dispatch may cover only the face cells whose x lies in
// [xLo, xHi).  x is the face's j axis when the face is normal to y, and its i
// axis when normal to z.  A face normal to x is never clipped -- it runs whole
// or not at all.  The flat sweep passes (0, 0xFFFFFFFF), which gives the
// plain row-major (i, j) walk over the whole face.
bool faceCell(uint t, out uint i, out uint j)
{
    i = 0u; j = 0u;
    if (ny == 1u)
    {
        uint hi = min(xHi, numLinesPP);
        if (hi <= xLo) return false;
        uint w = hi - xLo;
        if (t >= numLinesP * w) return false;
        i = t / w;
        j = xLo + t % w;
    }
    else if (ny == 2u)
    {
        uint hi = min(xHi, numLinesP);
        if (hi <= xLo) return false;
        if (t >= (hi - xLo) * numLinesPP) return false;
        i = xLo + t / numLinesPP;
        j = t % numLinesPP;
    }
    else
    {
        if (t >= numLinesP * numLinesPP) return false;
        i = t / numLinesPP;
        j = t % numLinesPP;
    }
    return true;
}

void main()
{
    uint i, j;
    if (!faceCell(gl_GlobalInvocationID.x, i, j)) return;
    uint gid = i * numLinesPP + j;
    uint N = Nx * Ny * Nz;

    uint nP  = compP(ny);
    uint nPP = compPP(ny);

    uint gPos = gridIdx(ny, lineNr, i, j);

    // Where two faces meet, both write the field component along their common
    // edge.  The CPU applies equal-priority extensions in reverse order of
    // creation, so the earlier face wins there; the host sets a bit for every
    // edge of this face that an earlier face owns.  Bits 1/2: the edge at
    // i = 0 / numLinesP-1 (component nyPP); bits 4/8: j = 0 / numLinesPP-1
    // (component nyP).
    bool skipPP = ((edgeSkip & 1u) != 0u && i == 0u) || ((edgeSkip & 2u) != 0u && i == numLinesP - 1u);
    bool skipP  = ((edgeSkip & 4u) != 0u && j == 0u) || ((edgeSkip & 8u) != 0u && j == numLinesPP - 1u);
    if (!skipP)
        volt[nP  * N + gPos] = mur_nyP[faceOff + gid];
    if (!skipPP)
        volt[nPP * N + gPos] = mur_nyPP[faceOff + gid];
}
