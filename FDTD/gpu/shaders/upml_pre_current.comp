/*
 * UPML Pre-Current Update compute shader.
 *
 * Implements (for each PML cell, 3 components):
 *   f_help    = pml_ii[n] * curr[global_idx] - pml_iifo[n] * curr_flux[local_idx]
 *   curr[global_idx]      = curr_flux[local_idx]
 *   curr_flux[local_idx]  = f_help
 *
 * This runs BEFORE the main Yee current update.
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) buffer CurrBuf     { float curr[];      };
layout(set=0, binding=1) buffer CurrFluxBuf { float curr_flux[];  };
layout(set=0, binding=2) buffer PmlIdxBuf   { uint  pmlCoefIdx[]; };
layout(set=0, binding=3) buffer IIBuf       { float pml_ii[];    };
layout(set=0, binding=4) buffer IIFOBuf     { float pml_iifo[];  };

layout(push_constant) uniform PC {
    uint Nx, Ny, Nz;
    uint pNx, pNy, pNz;
    uint pStartX, pStartY, pStartZ;
    // Temporal blocking: this dispatch owns PML-region-local linear indices
    // [gidBase, gidEnd).  lx is the slowest axis of that index, so a global
    // x-slab is a contiguous run here too; the host clips the slab against
    // this region's x-extent.  The flat sweep passes (0, 0xFFFFFFFF).
    uint gidBase, gidEnd;
};

// --- PML coefficient index -----------------------------------------------
// The UPML coefficients depend on the grading profile (a function of depth
// into the PML) and the local material, so they are enormously redundant
// across the transverse plane: an 80^3 grid with PML_8 on all six sides has
// 821016 coefficient entries but only ~1100 distinct (vv,vvfo,vvfn,ii,iifo,
// iifn) tuples, and a graded mesh barely changes that. They are therefore
// deduplicated into small tables -- small enough to stay cache-resident,
// unlike the Yee operator table -- with one narrow index per entry. The
// width is a specialization constant so the driver folds this to a single
// path at pipeline creation. Packing is little-endian within each dword,
// matching the host-side packer.
layout(constant_id = 1) const uint PMLIDX_BITS = 32;

uint fetchPmlIdx(uint cell)
{
    if (PMLIDX_BITS == 8u)
        return bitfieldExtract(pmlCoefIdx[cell >> 2], int((cell & 3u) << 3), 8);
    if (PMLIDX_BITS == 16u)
        return bitfieldExtract(pmlCoefIdx[cell >> 1], int((cell & 1u) << 4), 16);
    return pmlCoefIdx[cell];
}

void main()
{
    uint gid = gl_GlobalInvocationID.x + gidBase;
    uint pN = pNx * pNy * pNz;
    if (gid >= pN || gid >= gidEnd) return;

    uint lz = gid % pNz;
    uint ly = (gid / pNz) % pNy;
    uint lx = gid / (pNy * pNz);

    uint gx = lx + pStartX;
    uint gy = ly + pStartY;
    uint gz = lz + pStartZ;

    uint N   = Nx * Ny * Nz;
    uint sYZ = Ny * Nz;
    uint g_base = gx * sYZ + gy * Nz + gz;
    uint l_base = gid;

    // --- Component 0 (x) ---
    {
        uint gi = g_base;
        uint li = l_base;
        uint ci = fetchPmlIdx(li);
        float I   = curr[gi];
        float F   = curr_flux[li];
        float fh  = pml_ii[ci] * I - pml_iifo[ci] * F;
        curr[gi]      = F;
        curr_flux[li] = fh;
    }

    // --- Component 1 (y) ---
    {
        uint gi = N + g_base;
        uint li = pN + l_base;
        uint ci = fetchPmlIdx(li);
        float I   = curr[gi];
        float F   = curr_flux[li];
        float fh  = pml_ii[ci] * I - pml_iifo[ci] * F;
        curr[gi]      = F;
        curr_flux[li] = fh;
    }

    // --- Component 2 (z) ---
    {
        uint gi = 2*N + g_base;
        uint li = 2*pN + l_base;
        uint ci = fetchPmlIdx(li);
        float I   = curr[gi];
        float F   = curr_flux[li];
        float fh  = pml_ii[ci] * I - pml_iifo[ci] * F;
        curr[gi]      = F;
        curr_flux[li] = fh;
    }
}
