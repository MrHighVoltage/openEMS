/*
 * Total-Field/Scattered-Field (TF/SF) current injection shader.
 *
 * Same structure as tfsf_voltage.comp but uses the E-field (voltage) signal
 * for current injection, and operates on the current field buffer.
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) buffer FieldBuf  { float field[];  };
layout(set=0, binding=1) buffer AmpBuf    { float amp[];    };
layout(set=0, binding=2) buffer DeltaBuf  { float delta[];  };
layout(set=0, binding=3) buffer IdxBuf    { uint  linIdx[]; };
layout(set=0, binding=4) buffer DelayBuf  { uint  delay[];  };
layout(set=0, binding=5) buffer SignalBuf { float signal[]; };  // voltage signal

layout(push_constant) uniform PC {
    uint count;
    int  numTS;
    uint sigLen;
    int  sigPeriod;
};

int lookupDelay(int ts, uint d)
{
    int pos = ts - int(d);
    if (pos < 0) return 0;
    int p = (sigPeriod > 0) ? sigPeriod : (ts + 1);
    pos = pos % p;
    if (pos >= int(sigLen)) return 0;
    return pos;
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= count) return;

    // Injection points on the TF/SF box's edges belong to two faces, so several
    // entries target the same field element -- 132 of 1452 voltage entries on a
    // 20^3 box. A plain `field[linIdx[gid]] +=` from each of them is a
    // read-modify-write race: contributions are silently dropped and the run is
    // not even reproducible against itself. The host sorts the entries by field
    // index (stably, so entries sharing one keep their original relative
    // order), and the thread that owns the start of each run applies the whole
    // run itself.
    uint idx = linIdx[gid];
    if (gid > 0u && linIdx[gid - 1u] == idx) return;

    float acc = 0.0;
    for (uint j = gid; j < count && linIdx[j] == idx; ++j)
    {
        int pos0 = lookupDelay(numTS, delay[j]);
        int pos1 = lookupDelay(numTS, delay[j] + 1u);
        acc += ((1.0 - delta[j]) * signal[pos0] + delta[j] * signal[pos1]) * amp[j];
    }
    field[idx] += acc;
}
