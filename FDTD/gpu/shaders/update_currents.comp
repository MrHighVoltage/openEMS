/*
 * FDTD H-field (current) update compute shader — compressed operator.
 *
 * Implements:
 *   curr[n][x][y][z] = ii_comp[n*C + idx] * curr[n][x][y][z]
 *                     + iv_comp[n*C + idx] * curl_E(x,y,z)
 *
 * where idx = opIdx[gid_full] is a per-cell index into compressed
 * coefficient tables.  gid_full is the index into the full N grid,
 * not the reduced (Nx-1)*(Ny-1)*(Nz-1) dispatch domain.
 *
 * Loop domain: x ∈ [0, Nx-2], y ∈ [0, Ny-2], z ∈ [0, Nz-2]
 * (one fewer than voltage update in each dimension due to Yee staggering).
 * Index into the full field arrays still uses Nx, Ny, Nz strides.
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) buffer CurrBuf   { float curr[];    };
layout(set=0, binding=1) buffer VoltBuf   { float volt[];    };
layout(set=0, binding=2) buffer OpIdxBuf  { uint  opIdx[];   };
layout(set=0, binding=3) buffer IIBuf     { float ii_comp[]; };
layout(set=0, binding=4) buffer IVBuf     { float iv_comp[]; };

layout(push_constant) uniform PC {
    uint Nx, Ny, Nz, numComp;
};

// --- Compressed-operator index width -------------------------------------
// opIdx is one index per cell into the compressed coefficient tables, read
// once per cell per kernel -- on large grids it is ~10% of all memory traffic
// (measured). The needed width is known at operator setup, so it is a
// specialization constant: the driver folds this to a single path at pipeline
// creation, leaving no runtime branch. The buffer stays declared `uint` and
// narrow values are unpacked by hand, so no 8/16-bit storage feature is
// required. Packing is little-endian within each dword: cell c occupies bits
// [(c%k)*bits, +bits) of word c/k, matching the host-side packer.
layout(constant_id = 0) const uint OPIDX_BITS = 32;

uint fetchOpIdx(uint cell)
{
    // 0 = no deduplication: the tables hold one entry per cell and no index
    // buffer is uploaded, so the cell number indexes them directly.
    if (OPIDX_BITS == 0u)
        return cell;
    if (OPIDX_BITS == 8u)
        return bitfieldExtract(opIdx[cell >> 2], int((cell & 3u) << 3), 8);
    if (OPIDX_BITS == 16u)
        return bitfieldExtract(opIdx[cell >> 1], int((cell & 1u) << 4), 16);
    return opIdx[cell];
}


void main()
{
    uint gid = gl_GlobalInvocationID.x;

    // Current update domain is (Nx-1) × (Ny-1) × (Nz-1)
    uint cNx = Nx - 1u;
    uint cNy = Ny - 1u;
    uint cNz = Nz - 1u;
    uint cN  = cNx * cNy * cNz;
    if (gid >= cN) return;

    // Decompose within the reduced domain
    uint z = gid % cNz;
    uint y = (gid / cNz) % cNy;
    uint x = gid / (cNy * cNz);

    // Full field strides
    uint N   = Nx * Ny * Nz;
    uint sYZ = Ny * Nz;

    uint base = x * sYZ + y * Nz + z;

    // Per-cell compressed coefficient index (using full-grid cell index)
    uint oi = fetchOpIdx(base);

    // Fetch compressed coefficients for all 3 components
    float ii0 = ii_comp[oi];
    float iv0 = iv_comp[oi];
    float ii1 = ii_comp[numComp + oi];
    float iv1 = iv_comp[numComp + oi];
    float ii2 = ii_comp[2u * numComp + oi];
    float iv2 = iv_comp[2u * numComp + oi];

    // E at "here": each of the three components feeds two of the three curls
    // below.  Load each once, and form all three curls before the first store
    // so no compiler has to reload volt[] across a store to curr[].
    float vx = volt[       base];
    float vy = volt[   N + base];
    float vz = volt[2u*N + base];

    // curl_x = volt_z(x,y,z) - volt_z(x,y+1,z) - volt_y(x,y,z) + volt_y(x,y,z+1)
    float curl0 = vz - volt[2u*N + base + Nz  ]
                - vy + volt[   N + base + 1   ];
    // curl_y = volt_x(x,y,z) - volt_x(x,y,z+1) - volt_z(x,y,z) + volt_z(x+1,y,z)
    float curl1 = vx - volt[        base + 1   ]
                - vz + volt[2u*N  + base + sYZ];
    // curl_z = volt_y(x,y,z) - volt_y(x+1,y,z) - volt_x(x,y,z) + volt_x(x,y+1,z)
    float curl2 = vy - volt[   N + base + sYZ]
                - vx + volt[        base + Nz ];

    uint idx0 = base;
    uint idx1 = N + base;
    uint idx2 = 2u*N + base;
    curr[idx0] = fma(ii0, curr[idx0], iv0 * curl0);
    curr[idx1] = fma(ii1, curr[idx1], iv1 * curl1);
    curr[idx2] = fma(ii2, curr[idx2], iv2 * curl2);
}
