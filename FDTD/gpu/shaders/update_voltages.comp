/*
 * FDTD E-field (voltage) update compute shader — compressed operator.
 *
 * Implements:
 *   volt[n][x][y][z] = vv_comp[n*C + idx] * volt[n][x][y][z]
 *                     + vi_comp[n*C + idx] * curl_H(x,y,z)
 *
 * where idx = opIdx[gid] is a per-cell index into compressed coefficient
 * tables (typically a few hundred entries vs millions of cells).  The small
 * tables stay L2-resident, eliminating VRAM round-trips for coefficients.
 *
 * Memory layout: N-I-J-K (component-major), same as ArrayNIJK<float>.
 *   index(n, x, y, z) = n * Nx*Ny*Nz + x * Ny*Nz + y * Nz + z
 *
 * Each thread handles one (x,y,z) cell for all 3 field components.
 * Boundary handling: at pos==0, the shifted neighbor index clamps to 0.
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) buffer VoltBuf   { float volt[];    };
layout(set=0, binding=1) buffer CurrBuf   { float curr[];    };
layout(set=0, binding=2) buffer OpIdxBuf  { uint  opIdx[];   };
layout(set=0, binding=3) buffer VVBuf     { float vv_comp[]; };
layout(set=0, binding=4) buffer VIBuf     { float vi_comp[]; };

layout(push_constant) uniform PC {
    uint Nx, Ny, Nz, numComp;
};

// --- Compressed-operator index width -------------------------------------
// opIdx is one index per cell into the compressed coefficient tables, read
// once per cell per kernel -- on large grids it is ~10% of all memory traffic
// (measured). The needed width is known at operator setup, so it is a
// specialization constant: the driver folds this to a single path at pipeline
// creation, leaving no runtime branch. The buffer stays declared `uint` and
// narrow values are unpacked by hand, so no 8/16-bit storage feature is
// required. Packing is little-endian within each dword: cell c occupies bits
// [(c%k)*bits, +bits) of word c/k, matching the host-side packer.
layout(constant_id = 0) const uint OPIDX_BITS = 32;

uint fetchOpIdx(uint cell)
{
    // 0 = no deduplication: the tables hold one entry per cell and no index
    // buffer is uploaded, so the cell number indexes them directly.
    if (OPIDX_BITS == 0u)
        return cell;
    if (OPIDX_BITS == 8u)
        return bitfieldExtract(opIdx[cell >> 2], int((cell & 3u) << 3), 8);
    if (OPIDX_BITS == 16u)
        return bitfieldExtract(opIdx[cell >> 1], int((cell & 1u) << 4), 16);
    return opIdx[cell];
}


void main()
{
    uint gid = gl_GlobalInvocationID.x;
    uint N = Nx * Ny * Nz;
    if (gid >= N) return;

    // Decompose linear index → (x, y, z).  z changes fastest for coalescing.
    uint z = gid % Nz;
    uint y = (gid / Nz) % Ny;
    uint x = gid / (Ny * Nz);

    // Shifted indices: clamp to 0 at boundaries
    uint xm = max(x, 1u) - 1u;
    uint ym = max(y, 1u) - 1u;
    uint zm = max(z, 1u) - 1u;

    uint sYZ = Ny * Nz;

    // Per-cell compressed coefficient index (same for all 3 components)
    uint oi = fetchOpIdx(gid);

    // Fetch compressed coefficients for all 3 components
    float vv0 = vv_comp[oi];
    float vi0 = vi_comp[oi];
    float vv1 = vv_comp[numComp + oi];
    float vi1 = vi_comp[numComp + oi];
    float vv2 = vv_comp[2u * numComp + oi];
    float vi2 = vi_comp[2u * numComp + oi];

    uint base = x * sYZ;
    uint here = base + y * Nz + z;

    // H at "here": each of the three components feeds two of the three curls
    // below.  Load each once -- see the header note on load reuse.
    float cx = curr[       here];
    float cy = curr[   N + here];
    float cz = curr[2u*N + here];

    // All three curls are formed before the first store: a store to volt[]
    // would otherwise force a reload of curr[] on any compiler that cannot
    // prove the two storage buffers do not alias.
    // curl_x = curr_z(x,y,z) - curr_z(x,ym,z) - curr_y(x,y,z) + curr_y(x,y,zm)
    float curl0 = cz - curr[2u*N + base + ym*Nz + z ]
                - cy + curr[   N + base + y*Nz  + zm];
    // curl_y = curr_x(x,y,z) - curr_x(x,y,zm) - curr_z(x,y,z) + curr_z(xm,y,z)
    float curl1 = cx - curr[          base + y*Nz + zm]
                - cz + curr[2u*N + xm*sYZ + y*Nz + z ];
    // curl_z = curr_y(x,y,z) - curr_y(xm,y,z) - curr_x(x,y,z) + curr_x(x,ym,z)
    float curl2 = cy - curr[   N + xm*sYZ + y*Nz + z ]
                - cx + curr[        base + ym*Nz + z];

    uint idx0 = here;
    uint idx1 = N + here;
    uint idx2 = 2u*N + here;
    volt[idx0] = fma(vv0, volt[idx0], vi0 * curl0);
    volt[idx1] = fma(vv1, volt[idx1], vi1 * curl1);
    volt[idx2] = fma(vv2, volt[idx2], vi2 * curl2);
}
