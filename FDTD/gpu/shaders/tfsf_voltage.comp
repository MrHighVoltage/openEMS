/*
 * Total-Field/Scattered-Field (TF/SF) voltage injection shader.
 *
 * Sparse dispatch: one thread per injection point.
 * All 12 face×component combinations are pre-flattened into linear arrays
 * by the CPU setup code.
 *
 * For each injection point:
 *   field[linIdx] += ((1-delta)*signal[pos0] + delta*signal[pos1]) * amp
 *
 * where pos0 = lookup(delay), pos1 = lookup(delay+1),
 * and lookup(d) = clamp_and_wrap(numTS - d, sigLen, sigPeriod).
 *
 * Uses the H-field (current) signal for voltage injection.
 */
#version 450

layout(local_size_x = 256) in;

layout(set=0, binding=0) buffer FieldBuf  { float field[];  };
layout(set=0, binding=1) buffer AmpBuf    { float amp[];    };  // amplitude per injection point
layout(set=0, binding=2) buffer DeltaBuf  { float delta[];  };  // interpolation fraction per point
layout(set=0, binding=3) buffer IdxBuf    { uint  linIdx[]; };  // pre-linearized field index
layout(set=0, binding=4) buffer DelayBuf  { uint  delay[];  };  // per-point delay
layout(set=0, binding=5) buffer SignalBuf { float signal[]; };  // excitation signal (H-field / current)

layout(push_constant) uniform PC {
    uint count;       // total injection points
    int  numTS;       // current timestep
    uint sigLen;      // signal length
    int  sigPeriod;   // signal period (<=0 if non-periodic)
};

int lookupDelay(int ts, uint d)
{
    int pos = ts - int(d);
    // Zero if before signal starts
    if (pos < 0) return 0;
    // Periodic wrapping
    int p = (sigPeriod > 0) ? sigPeriod : (ts + 1);
    pos = pos % p;
    // Zero if beyond signal length (non-periodic case)
    if (pos >= int(sigLen)) return 0;
    return pos;
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= count) return;

    // Injection points on the TF/SF box's edges belong to two faces, so several
    // entries target the same field element -- 132 of 1452 voltage entries on a
    // 20^3 box. A plain `field[linIdx[gid]] +=` from each of them is a
    // read-modify-write race: contributions are silently dropped and the run is
    // not even reproducible against itself. The host sorts the entries by field
    // index (stably, so entries sharing one keep their original relative
    // order), and the thread that owns the start of each run applies the whole
    // run itself.
    uint idx = linIdx[gid];
    if (gid > 0u && linIdx[gid - 1u] == idx) return;

    float acc = 0.0;
    for (uint j = gid; j < count && linIdx[j] == idx; ++j)
    {
        int pos0 = lookupDelay(numTS, delay[j]);
        int pos1 = lookupDelay(numTS, delay[j] + 1u);
        acc += ((1.0 - delta[j]) * signal[pos0] + delta[j] * signal[pos1]) * amp[j];
    }
    field[idx] += acc;
}
